# Copy to .env (`make setup`) for local use. On the IT-hosted VM this file is
# assembled by Ansible from the Terraform `tt_docker_compose_override_vars`,
# so only ever edit it there for quick experiments.

# --- Tailscale -------------------------------------------------------------
# Tagged, reusable auth key. Ask IT for one scoped to the ACL tag that grants
# the network segments the agents need to reach. Pre-approved + ephemeral=false
# so the node survives container restarts.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Tailnet node name. Keep it aligned with the VM hostname IT assigns.
TS_HOSTNAME=gateway

# --accept-routes is what makes advertised subnets reachable from the agents.
# Add --advertise-tags=tag:gateway if the auth key isn't already tagged.
TS_EXTRA_ARGS=--accept-routes

# --- Deployment ------------------------------------------------------------
# Provided by IT. Parent directory for all persistent state; must live on the
# VM's persistent volume, not the root disk.
DATA_DIR=./data

# Provided by IT.
FQDN=

TZ=America/Toronto

# Must match the uid/gid of the application account that owns /srv/gateway.
APP_UID=1000
APP_GID=1000

PYTHON_VERSION=3.13
MEMORY_LIMIT=8g
GATEWAY_SESSION=gateway

# --- Agent credentials -----------------------------------------------------
# Supplied from 1Password via the IT env file in production. Never commit.
ANTHROPIC_API_KEY=
